# Public Vite variables only. Never put provider secrets in VITE_* files.
# Copy to .env.local locally if you need the optional AI/gallery features.
# The site works without these; tools degrade to manual editing.
#
# AI provider keys are SERVER secrets on the Supabase edge function, not here.
# Set them with: npx supabase secrets set OPENROUTER_API_KEY=...
# and optionally ONEPROVIDER_API_KEY=...  Visitors may also BYOK in the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
